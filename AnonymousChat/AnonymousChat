from flask import Flask, request, jsonify, session
import secrets
import string
from datetime import datetime

app = Flask(__name__)
app.secret_key = "change-this-secret-key"

messages = []
users = {}


def generate_id():
    characters = string.ascii_uppercase + string.digits
    return "AC-" + "".join(secrets.choice(characters) for _ in range(6))


@app.route("/")
def home():
    if "anonymous_id" not in session:
        anonymous_id = generate_id()

        while anonymous_id in users:
            anonymous_id = generate_id()

        session["anonymous_id"] = anonymous_id

        users[anonymous_id] = {
            "joined": datetime.now().strftime("%H:%M")
        }

    return HTML


@app.route("/my_id")
def my_id():
    return jsonify({
        "id": session["anonymous_id"]
    })


# -------------------------
# GROUP CHAT
# -------------------------

@app.route("/send_group", methods=["POST"])
def send_group():

    data = request.get_json()
    message = data.get("message", "").strip()

    if not message:
        return jsonify({"error": "Empty message"}), 400

    anonymous_id = session.get("anonymous_id")

    if not anonymous_id:
        return jsonify({"error": "No Anonymous ID"}), 400

    messages.append({
        "type": "group",
        "id": anonymous_id,
        "message": message,
        "time": datetime.now().strftime("%H:%M")
    })

    return jsonify({"success": True})


@app.route("/group_messages")
def group_messages():

    return jsonify([
        m for m in messages
        if m["type"] == "group"
    ])


# -------------------------
# PRIVATE CHAT
# -------------------------

@app.route("/check_id/<target_id>")
def check_id(target_id):

    target_id = target_id.upper()

    return jsonify({
        "exists": target_id in users
    })


@app.route("/send_private", methods=["POST"])
def send_private():

    data = request.get_json()

    target_id = data.get("target_id", "").upper()
    message = data.get("message", "").strip()

    sender_id = session.get("anonymous_id")

    if not sender_id:
        return jsonify({"error": "No Anonymous ID"}), 400

    if target_id not in users:
        return jsonify({"error": "That Anonymous ID does not exist"}), 404

    if not message:
        return jsonify({"error": "Empty message"}), 400

    if target_id == sender_id:
        return jsonify({"error": "You cannot message yourself"}), 400

    messages.append({
        "type": "private",
        "sender": sender_id,
        "receiver": target_id,
        "message": message,
        "time": datetime.now().strftime("%H:%M")
    })

    return jsonify({"success": True})


@app.route("/private_messages/<target_id>")
def private_messages(target_id):

    my_id = session.get("anonymous_id")
    target_id = target_id.upper()

    private = []

    for m in messages:

        if m["type"] != "private":
            continue

        if (
            m["sender"] == my_id and
            m["receiver"] == target_id
        ) or (
            m["sender"] == target_id and
            m["receiver"] == my_id
        ):

            private.append(m)

    return jsonify(private)


@app.route("/users")
def get_users():

    return jsonify({
        "online": len(users)
    })


