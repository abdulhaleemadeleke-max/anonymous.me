<script>

let myID = "";

let privateTarget = "";


/* GET MY AUTOMATIC ID */

async function getID() {

    const response =
        await fetch("/my_id");

    const data =
        await response.json();

    myID = data.id;

    document.getElementById("myID")
        .textContent = myID;
}


/* GROUP CHAT */

async function sendGroup() {

    const input =
        document.getElementById("groupInput");

    const message =
        input.value.trim();

    if (!message) return;

    await fetch("/send_group", {

        method: "POST",

        headers: {
            "Content-Type": "application/json"
        },

        body: JSON.stringify({
            message: message
        })

    });

    input.value = "";

    loadGroup();
}


async function loadGroup() {

    const response =
        await fetch("/group_messages");

    const data =
        await response.json();

    const box =
        document.getElementById("messages");

    box.innerHTML = "";

    data.forEach(msg => {

        const div =
            document.createElement("div");

        div.className = "message";

        div.innerHTML =
            "<span class='user'>" +
            escapeHTML(msg.id) +
            "</span>" +

            "<span class='time'>" +
            escapeHTML(msg.time) +
            "</span>" +

            "<div class='text'>" +
            escapeHTML(msg.message) +
            "</div>";

        box.appendChild(div);

    });

    box.scrollTop = box.scrollHeight;
}


/* START PRIVATE CHAT */

async function startPrivate() {

    const input =
        document.getElementById("targetID");

    const target =
        input.value.trim().toUpperCase();

    if (!target) return;

    const response =
        await fetch("/check_id/" + target);

    const data =
        await response.json();

    if (!data.exists) {

        document.getElementById("privateStatus")
            .textContent =
            "❌ That Anonymous ID was not found.";

        document.getElementById("privateStatus")
            .style.color = "#f87171";

        return;
    }

    privateTarget = target;

    document.getElementById("privateStatus")
        .textContent =
        "🔒 Private chat with " + target;

    document.getElementById("privateStatus")
        .style.color = "#4ade80";

    loadPrivate();
}


/* SEND PRIVATE MESSAGE */

async function sendPrivate() {

    if (!privateTarget) {

        alert("Enter an Anonymous ID first.");

        return;
    }

    const input =
        document.getElementById("privateInput");

    const message =
        input.value.trim();

    if (!message) return;

    const response =
        await fetch("/send_private", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                target_id: privateTarget,

                message: message

            })

        });

    const data =
        await response.json();

    if (data.error) {

        alert(data.error);

        return;
    }

    input.value = "";

    loadPrivate();
}


/* LOAD PRIVATE MESSAGES */

async function loadPrivate() {

    if (!privateTarget) return;

    const response =
        await fetch(
            "/private_messages/" +
            privateTarget
        );

    const data =
        await response.json();

    const box =
        document.getElementById("privateMessages");

    box.innerHTML = "";

    data.forEach(msg => {

        const div =
